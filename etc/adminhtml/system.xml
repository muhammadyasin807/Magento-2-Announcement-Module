<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="doit"
             translate="label"
             sortOrder="200">
            <label>Doit</label>
        </tab>

        <section id="doit_announcement"
                 translate="label"
                 type="text"
                 sortOrder="10"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">

            <label>Announcements</label>

            <tab>doit</tab>

            <resource>Doit_Announcement::config</resource>

            <group id="general"
                   translate="label"
                   type="text"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">

                <label>General</label>

                <field id="enabled"
                       translate="label comment"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">

                    <label>Enable Announcements</label>

                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>

                    <comment>Enable or disable announcement functionality.</comment>

                </field>
                <field id="max_items"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">

                    <label>Maximum Announcements</label>

                    <validate>validate-number validate-greater-than-zero</validate>
                    <backend_model>Doit\Announcement\Model\Config\Backend\MaxItems</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                    <comment>Maximum number of announcements to display.</comment>

                </field>
                <field id="display_mode"
                       translate="label comment"
                       type="select"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">

                    <label>Display Mode</label>

                    <source_model>Doit\Announcement\Model\Config\Source\DisplayMode</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                    <comment>Select how announcements should be ordered.</comment>

                </field>

                <field id="api_secret"
                       translate="label comment"
                       type="obscure"
                       sortOrder="40"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">

                    <label>API Secret</label>

                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>

                    <comment>Secret key used by an external API.</comment>

                </field>
            </group>

        </section>
    </system>
</config>
