<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                doit_announcement_listing.doit_announcement_listing_data_source
            </item>
        </item>
    </argument>

    <settings>
        <spinner>doit_announcement_columns</spinner>

        <deps>
            <dep>
                doit_announcement_listing.doit_announcement_listing_data_source
            </dep>
        </deps>
        <buttons>
            <button name="add">
                <url path="announcement/announcement/new"/>
                <class>primary</class>
                <label translate="true">Add New Announcement</label>
            </button>
        </buttons>
    </settings>

    <dataSource name="doit_announcement_listing_data_source"
                component="Magento_Ui/js/grid/provider">

        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">
                    announcement_id
                </param>
            </storageConfig>

            <updateUrl path="mui/index/render"/>
        </settings>

        <aclResource>Doit_Announcement::manage</aclResource>

        <dataProvider
            class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
            name="doit_announcement_listing_data_source">

            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>announcement_id</primaryFieldName>
            </settings>

        </dataProvider>

    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>

        <bookmark name="bookmarks"/>

        <columnsControls name="columns_controls"/>

        <filters name="listing_filters"/>

        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="doit_announcement_columns">

        <column name="announcement_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>

        <column name="title">
            <settings>
                <filter>text</filter>
                <label translate="true">Title</label>
            </settings>
        </column>


    <column name="start_date"
            class="Magento\Ui\Component\Listing\Columns\Date">
        <settings>
            <filter>dateRange</filter>
            <dataType>date</dataType>
            <label translate="true">Start Date</label>
        </settings>
    </column>
    <column name="end_date"
            class="Magento\Ui\Component\Listing\Columns\Date">
        <settings>
            <filter>dateRange</filter>
            <dataType>date</dataType>
            <label translate="true">End Date</label>
        </settings>
    </column>
    <column name="created_at"
            class="Magento\Ui\Component\Listing\Columns\Date">
        <settings>
            <filter>dateRange</filter>
            <dataType>date</dataType>
            <label translate="true">Created At</label>
        </settings>
    </column>
    <column name="updated_at"
            class="Magento\Ui\Component\Listing\Columns\Date">
        <settings>
            <filter>dateRange</filter>
            <dataType>date</dataType>
            <label translate="true">Updated At</label>
        </settings>
    </column>
    <column name="sort_order">
        <settings>
            <filter>textRange</filter>
            <dataType>number</dataType>
            <label translate="true">Sort Order</label>
        </settings>
    </column>
        <column name="status"
                component="Magento_Ui/js/grid/columns/select">

            <settings>
                <options class="Doit\Announcement\Model\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>

        </column>

        <actionsColumn
            name="actions"
            class="Doit\Announcement\Ui\Component\Listing\Column\AnnouncementActions">

            <settings>
                <indexField>announcement_id</indexField>
                <label translate="true">Actions</label>
            </settings>

        </actionsColumn>
    </columns>

</listing>
